# ---- 依赖与构建产物 ----
node_modules/
dist/
web/dist/
out/
.vite/
*.tsbuildinfo

# ---- 运行时数据 ----
# 库文件与加密后的订阅源正文只在本机/容器卷里，不进版本库。
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---- 凭据 ----
# .env 含 STARTRAILS_TOKEN_SECRET 与管理员令牌，只提交模板。
.env
.env.*
!.env.example
# UI 设置的加密密钥（默认在 data/ 下，这里兜底自定义 STARTRAILS_SECRET_FILE）。
*.key

# ---- 测试与工具缓存 ----
coverage/
.nyc_output/
*.log
npm-debug.log*
yarn-error.log*
.eslintcache
.cache/

# ---- 本地草稿 ----
# 设计审核稿（scratch/*.html）属于过程产物，README 不引用它，别人 clone 下来只会困惑，
# 因此不入库；文件仍留在本机，`git clean -fd` 不会删被忽略的路径（只有 -x 才会）。
scratch/

# ---- 编辑器与操作系统 ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Agent 工作目录 ----
# 本地协作记录（含本机路径、临时结论），不随代码分发；
# 若希望团队共享，删掉这一行即可（不会删除任何已有文件）。
.workbuddy/
