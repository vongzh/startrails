# Startrails 环境变量模板
# 复制为 .env 并按需填写；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 完整说明见 README「环境变量」一节。

# 【可选】加密密钥：加密订阅源正文等敏感字段。更换后旧数据将无法解密。
# 优先级：环境变量 STARTRAILS_TOKEN_SECRET > STARTRAILS_SECRET_FILE 指向的文件 > 首次在 Web UI 设置。
# 留空时首次进入会要求设置，并落盘到 data/secret.key；已有数据的实例必须继续用原密钥。
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
STARTRAILS_TOKEN_SECRET=

# 【可选】UI 设置的密钥落盘位置，默认 <STARTRAILS_DATA_DIR>/secret.key
# STARTRAILS_SECRET_FILE=./data/secret.key

# 【可选】管理令牌：登录工作台用。留空时首次访问在 Web UI 设定并写入数据库，重启后仍有效。
# 填了值则环境变量优先，数据库里那枚令牌不再生效。
STARTRAILS_ADMIN_TOKEN=

# 【可选】数据与监听
# STARTRAILS_DATA_DIR=./data
# STARTRAILS_DB_PATH=./data/startrails.db
# STARTRAILS_PORT=8787
# STARTRAILS_HOST=127.0.0.1
# STARTRAILS_WEB_ROOT=./web/dist

# 【可选】对外基地址：配置后外部规则集改写为 `${基地址}/rules/<key>`，二维码也用它拼绝对地址。
# 走 TLS 反代时必须设置，否则按请求 Host 拼地址容易出错。
# STARTRAILS_PUBLIC_BASE_URL=https://sub.example.com

# 【危险】放行本地/内网地址，仅本机测试用；公网部署不要开启。
# STARTRAILS_ALLOW_PRIVATE=0

# 【可选】开放无状态一次性转换 GET /sub?url=&target=（默认关闭）
# STARTRAILS_ALLOW_STATELESS=0

# 【可选】WebDAV 远端备份目标（建议私有目录，不要用公开可达的地址）
# STARTRAILS_WEBDAV_URL=https://dav.example.com/backup/
# STARTRAILS_WEBDAV_USER=
# STARTRAILS_WEBDAV_PASS=

# 【可选】运维通知渠道，任选其一或都配
# STARTRAILS_TG_BOT_TOKEN=
# STARTRAILS_TG_CHAT_ID=
# STARTRAILS_BARK_URL=
